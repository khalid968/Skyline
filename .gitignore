# --- Flutter / Dart ---
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
# android/, ios/ and windows/ ARE committed (the v1 platforms carry real
# configuration: app id, OS minimums, NDK). The rest are not v1 targets.
apps/mobile/macos/
apps/mobile/linux/
apps/mobile/web/
apps/mobile/*.iml
apps/mobile/.metadata
**/*.g.dart
**/*.freezed.dart

# --- Node / NestJS ---
**/node_modules/
apps/backend/dist/
apps/backend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Rust ---
crypto-core/target/
**/*.rs.bk
# Cargo.lock IS committed: it pins every transitive crate the crypto core is
# built from (supply-chain reproducibility).

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Docker / infra ---
infra/docker/**/*.log

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Pretend-phone state from apps/backend/scripts/dev-device.js (holds a private key)
.dev-device.json

# --- Push credentials (never commit) ---
*firebase-service-account*.json
**/google-services.json
**/GoogleService-Info.plist
