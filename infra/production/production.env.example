# Copy to `.env` in this folder ON THE SERVER, fill in, and keep it there.
# Never commit it. `./generate-secrets.sh` fills every random value for you.

# Where Skyline lives, and who Let's Encrypt writes to about certificates.
SKYLINE_DOMAIN=chat.example.org
SKYLINE_ADMIN_EMAIL=you@example.org

# Which images to run (set by deploy.sh; "local" builds on the server).
SKYLINE_REGISTRY=skyline
SKYLINE_VERSION=local

# Random secrets, at least 32 characters each (generate-secrets.sh).
POSTGRES_PASSWORD=
SKYLINE_APP_DB_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=skyline-media
MINIO_ROOT_PASSWORD=
AUTH_TOKEN_PEPPER=
AUTH_TOTP_KEY=
TURN_SECRET=

# Backups (owner decision: on this server, 30 days). The PUBLIC half of your
# age key (age-keygen on your own computer; the private half stays with you).
BACKUP_AGE_RECIPIENT=age1...
BACKUP_HOUR=3

# Apps older than this are asked to update (board 42).
APP_MIN_VERSION=1.0.0

# Android push wake-ups: put the Firebase service-account JSON in ./secrets/
# and name it here (inside the container: /run/skyline-secrets/<file>).
FCM_SERVICE_ACCOUNT_FILE=

# Connections to the database from the API (20 measured well at 500 people).
DATABASE_POOL_MAX=20
