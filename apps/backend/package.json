{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "admin:create": "babel-node src/cli/admin-create.js",
    "dev:device": "node scripts/dev-device.js",
    "format": "prettier --write \"**/*.js\"",
    "migrate": "node-pg-migrate --envPath .env -m src/database/migrations -j sql",
    "migrate:create": "node-pg-migrate create --envPath .env -m src/database/migrations -j sql",
    "migrate:down": "node-pg-migrate down --envPath .env -m src/database/migrations -j sql",
    "migrate:redo": "node-pg-migrate redo --envPath .env -m src/database/migrations -j sql",
    "migrate:up": "node-pg-migrate up --envPath .env -m src/database/migrations -j sql",
    "start": "babel-node index.js",
    "start:dev": "nodemon",
    "test": "jest",
    "test:app": "jest --config ./test/jest-e2e.json --runInBand app/",
    "test:cov": "jest --coverage",
    "test:db": "jest --config ./test/jest-e2e.json --runInBand db/",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "user:invite": "babel-node src/cli/invite.js",
    "build": "babel src -d dist --copy-files",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@babel/runtime": "7.29.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "node-pg-migrate": "^9.0.0",
    "otplib": "^13.5.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.29.7",
    "@babel/node": "7.29.0",
    "@babel/plugin-proposal-decorators": "7.29.0",
    "@babel/plugin-transform-runtime": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/register": "7.28.6",
    "@nestjs/testing": "^11.0.1",
    "jest": "30.3.0",
    "nodemon": "3.1.14",
    "prettier": "3.8.3",
    "supertest": "7.2.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "rootDir": ".",
    "testRegex": ".spec.js$",
    "coverageDirectory": "<rootDir>/coverage",
    "transformIgnorePatterns": [
      "/node_modules/(?!(@scure|@noble|@otplib|otplib)/)"
    ],
    "roots": [
      "<rootDir>/src"
    ]
  }
}
