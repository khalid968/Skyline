NODE_ENV=development
# error | warn | log | debug | verbose | silent  (silent under NODE_ENV=test)
LOG_LEVEL=log

PORT=3000

DATABASE_URL=postgres://skyline:change-me@localhost:5432/skyline

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=skyline
DATABASE_PASSWORD=change-me
DATABASE_NAME=skyline
DATABASE_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
# Pub/sub channel for WebSocket fan-out across backend instances.
REDIS_EVENTS_CHANNEL=skyline:events

STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=skyline-media
