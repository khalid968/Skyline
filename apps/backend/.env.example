NODE_ENV=development
# error | warn | log | debug | verbose | silent  (silent under NODE_ENV=test)
LOG_LEVEL=log

PORT=3000

DATABASE_URL=postgres://skyline:change-me@localhost:5432/skyline

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=skyline
DATABASE_PASSWORD=change-me
DATABASE_NAME=skyline
DATABASE_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
# Pub/sub channel for WebSocket fan-out across backend instances.
REDIS_EVENTS_CHANNEL=skyline:events

# --- Authentication (Phase 5) -------------------------------------------------
# HMAC key for every stored activation code and session token. REQUIRED in
# production (32+ random characters). Changing it invalidates every code and
# signs out every device at once. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_PEPPER=
# Encrypts each administrator's 2FA secret at rest. REQUIRED in production (32+
# random characters). Changing it switches off everyone's 2FA.
AUTH_TOTP_KEY=

# Rate limiting (Redis). Leave these alone; tests change them, production refuses to.
RATE_LIMIT_PREFIX=skyline
RATE_LIMIT_SCALE=1

STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=skyline-media

# Push wake-ups for Android (Firebase Cloud Messaging). Path to the Google
# service-account JSON from your Firebase project. Unset: no push (the app
# still receives while it is open). NEVER commit that file.
# FCM_SERVICE_ACCOUNT_FILE=/secure/path/firebase-service-account.json
